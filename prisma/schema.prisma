// Schéma de la base de données KEUR BI (PostgreSQL).
// Il reprend les données que l'application gardait jusqu'ici dans le navigateur.
// Les montants en FCFA sont des BigInt : un Int plafonne à environ 2,1 milliards.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Comptes ─────────────

enum Role {
  acheteur
  vendeur
  agence
  agent
  notaire
  clerc
  moderateur
  admin
}

enum StatutKYC {
  non_soumis
  en_attente
  verifie
  rejete
}

enum Plan {
  gratuit
  pro
  promoteur
  essentiel
  pro_notaire
}

model Utilisateur {
  id                String    @id @default(cuid())
  email             String    @unique
  nom               String
  // Empreinte du mot de passe (jamais le mot de passe lui-même). Vide tant que la vraie connexion n'est pas branchée.
  motDePasseHash    String?
  role              Role      @default(acheteur)
  telephone         String?
  ville             String?
  suspendu          Boolean   @default(false)
  statutKYC         StatutKYC @default(non_soumis)
  plan              Plan?
  // Agence (agent) ou étude notariale (clerc) pour laquelle la personne travaille.
  rattachement      String?
  releveBancaire    String?
  inscritLe         DateTime  @default(now())
  derniereConnexion DateTime?

  kyc             DossierKYC?
  biens           Bien[]
  favoris         Favori[]
  dossiers        Dossier[]
  visites         Visite[]
  rendezVous      RendezVous[]
  alertes         Alerte[]
  signalements    Signalement[]
  avis            Avis[]
  conversations   Conversation[]
  messages        Message[]
  lectures        LectureConversation[]
  notificationsLues NotificationLue[]
  sessions        Session[]

  @@index([role])
}

// Session ouverte après connexion. Le navigateur garde un jeton secret ; la base n'en conserve que l'empreinte.
model Session {
  id            String      @id @default(cuid())
  jetonHash     String      @unique
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  creeLe        DateTime    @default(now())
  expireLe      DateTime

  @@index([utilisateurId])
}

// Pièces d'identité : la base ne garde que la référence des fichiers, rangés dans un stockage séparé et protégé.
model DossierKYC {
  id             String    @id @default(cuid())
  utilisateurId  String    @unique
  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  dateNaissance  DateTime?
  lieuNaissance  String?
  nationalite    String?
  typeDocument   String?
  numeroDocument String?
  recto          String?
  verso          String?
  selfie         String?
  justificatif   String?
  soumisLe       DateTime?
  motifRejet     String?
}

// Fichiers envoyés par les utilisateurs (photos des annonces). Gardés dans la base en attendant un stockage dédié ;
// le code passe par lib/serveur/fichiers.ts, seul endroit à changer le jour où ils déménagent.
model Fichier {
  id       String   @id @default(cuid())
  type     String
  taille   Int
  donnees  Bytes
  auteurId String?
  creeLe   DateTime @default(now())

  @@index([auteurId])
}

// ───────────── Annuaire ─────────────

model Agence {
  id          String  @id @default(cuid())
  slug        String  @unique
  nom         String
  initiales   String
  description String
  fondee      Int
  telephone   String
  email       String
  adresse     String
  horaires    String
  badges      String[]
  ventes      Int     @default(0)
  note        Float   @default(0)
  nbAvis      Int     @default(0)
  // Témoignages de présentation : [{ auteur, date, note, texte }]
  avisInitiaux Json   @default("[]")

  agents AgentAgence[]
  biens  Bien[]
}

model AgentAgence {
  id        String @id @default(cuid())
  agenceId  String
  agence    Agence @relation(fields: [agenceId], references: [id], onDelete: Cascade)
  initiales String
  nom       String
  role      String
  ventes    Int    @default(0)
  note      Float  @default(0)
}

model Notaire {
  id           String   @id @default(cuid())
  slug         String   @unique
  nom          String
  initiales    String
  etude        String
  ville        String
  region       String
  adresse      String
  telephone    String
  agreeDepuis  Int
  note         Float    @default(0)
  nbAvis       Int      @default(0)
  dossiers     Int      @default(0)
  satisfaction Int      @default(0)
  delaiTF      String
  specialites  String[]
  presentation String
  // [{ label, val }]
  tarifs       Json
  // [{ jour (1 = lundi), heures: ["09:00", …] }]
  creneaux     Json
  // Témoignages de présentation : [{ auteur, date, texte }]
  avisInitiaux Json     @default("[]")

  dossiersSuivis Dossier[]
  rendezVous     RendezVous[]

  @@index([region])
}

// ───────────── Annonces ─────────────

enum TypeBien {
  terrain
  villa
  appartement
  bureau
}

model Bien {
  id          String   @id @default(cuid())
  reference   String   @unique
  titre       String
  type        TypeBien
  superficie  Int
  prix        BigInt
  region      String
  ville       String
  quartier    String
  description String
  photo       String
  photos      String[]
  telephone   String
  lat         Float?
  lng         Float?

  // Vendeur : nom affiché, agence de l'annuaire si elle existe, compte qui a publié.
  agenceNom    String
  agenceId     String?
  agence       Agence?      @relation(fields: [agenceId], references: [id], onDelete: SetNull)
  auteurId     String?
  auteur       Utilisateur? @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  proprietaire String?

  // Titre Foncier déclaré par le vendeur.
  tfVerifie              Boolean   @default(false)
  tfNumero               String?
  tfConservation         String?
  tfDateEtablissement    DateTime?
  tfSuperficieCadastrale Int?

  vedette      Boolean   @default(false)
  boostJusquau DateTime?
  depublie     Boolean   @default(false)
  prixEnBaisse Boolean   @default(false)
  ancienPrix   BigInt?
  nbVues       Int       @default(0)
  publieLe     DateTime  @default(now())

  historiquePrix HistoriquePrix[]
  favoris        Favori[]
  dossiers       Dossier[]
  visites        Visite[]
  demandesTF     DemandeTF[]
  signalements   Signalement[]
  conversations  Conversation[]

  @@index([region, type])
  @@index([prix])
  @@index([depublie, publieLe])
}

model HistoriquePrix {
  id     String   @id @default(cuid())
  bienId String
  bien   Bien     @relation(fields: [bienId], references: [id], onDelete: Cascade)
  date   DateTime @default(now())
  prix   BigInt

  @@index([bienId])
}

model Favori {
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  bienId        String
  bien          Bien        @relation(fields: [bienId], references: [id], onDelete: Cascade)
  ajouteLe      DateTime    @default(now())
  note          String?

  @@id([utilisateurId, bienId])
}

model Alerte {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  // { q, type, region, prixMax, superficieMin, superficieMax, tfVerifie }
  criteres      Json
  frequence     String
  creeLe        DateTime    @default(now())
}

model Visite {
  id         String       @id @default(cuid())
  bienId     String
  bien       Bien         @relation(fields: [bienId], references: [id], onDelete: Cascade)
  acheteurId String
  acheteur   Utilisateur  @relation(fields: [acheteurId], references: [id], onDelete: Cascade)
  telephone  String?
  date       DateTime
  message    String?
  statut     StatutVisite @default(demandee)
  creeLe     DateTime     @default(now())

  @@index([bienId])
  @@index([acheteurId])
}

enum StatutVisite {
  demandee
  confirmee
  refusee
  annulee
}

// ───────────── Dossiers de vente ─────────────

enum StatutDossier {
  brouillon
  due_diligence
  tf_verifie
  compromis_signe
  en_signature
  actif
  enregistrement_dgid
  enregistre
  mute
}

enum IncidentDossier {
  litigieux
  resilie
}

model Dossier {
  id             String           @id @default(cuid())
  reference      String           @unique
  bienId         String
  bien           Bien             @relation(fields: [bienId], references: [id], onDelete: Restrict)
  acheteurId     String
  acheteur       Utilisateur      @relation(fields: [acheteurId], references: [id], onDelete: Restrict)
  notaireId      String?
  notaire        Notaire?         @relation(fields: [notaireId], references: [id], onDelete: SetNull)
  statut         StatutDossier    @default(brouillon)
  dateOuverture  DateTime         @default(now())
  dateCompromis  DateTime?
  dateActe       DateTime?
  dateLimiteDGID DateTime?
  notes          String?
  incident       IncidentDossier?

  offres        Offre[]
  evenements    EvenementDossier[]
  signatures    SignatureDossier[]
  paiements     Paiement[]
  pieces        PieceJointe[]
  demandesTF    DemandeTF[]
  conversations Conversation[]
  rendezVous    RendezVous[]
  avis          Avis[]

  @@index([acheteurId])
  @@index([bienId])
  @@index([statut])
}

enum AuteurOffre {
  acheteur
  agence
}

enum StatutOffre {
  en_attente
  acceptee
  refusee
  retiree
}

model Offre {
  id            String      @id @default(cuid())
  dossierId     String
  dossier       Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  auteur        AuteurOffre
  montant       BigInt
  acompte       String?
  delai         String?
  conditions    String?
  message       String?
  financement   String?
  validiteJours Int?
  date          DateTime    @default(now())
  statut        StatutOffre @default(en_attente)

  @@index([dossierId])
}

model EvenementDossier {
  id        String   @id @default(cuid())
  dossierId String
  dossier   Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  libelle   String

  @@index([dossierId])
}

enum Signataire {
  notaire
  acheteur
  vendeur
}

model SignatureDossier {
  dossierId  String
  dossier    Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  signataire Signataire
  nom        String
  date       DateTime   @default(now())
  // Tracé de la signature (image encodée).
  image      String

  @@id([dossierId, signataire])
}

enum TypePaiement {
  acompte
  solde
}

enum MoyenPaiement {
  virement
  mobile_money
  cheque
}

enum StatutPaiement {
  declare
  confirme
}

model Paiement {
  id        String         @id @default(cuid())
  dossierId String
  dossier   Dossier        @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type      TypePaiement
  montant   BigInt
  moyen     MoyenPaiement
  reference String
  statut    StatutPaiement @default(declare)
  date      DateTime       @default(now())

  @@index([dossierId])
}

model PieceJointe {
  id        String   @id @default(cuid())
  dossierId String
  dossier   Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  nom       String
  // Emplacement du fichier dans le stockage.
  fichier   String?
  auteur    String
  date      DateTime @default(now())

  @@index([dossierId])
}

// ───────────── Titres Fonciers (module cadastre, en pause) ─────────────

enum StatutDemandeTF {
  en_verification
  verifie
  invalide
}

model DemandeTF {
  id           String          @id @default(cuid())
  bienId       String?
  bien         Bien?           @relation(fields: [bienId], references: [id], onDelete: SetNull)
  dossierId    String?
  dossier      Dossier?        @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  numero       String
  region       String
  proprietaire String
  fichier      String?
  prioritaire  Boolean         @default(false)
  statut       StatutDemandeTF @default(en_verification)
  motif        String?
  demandeur    String
  soumisLe     DateTime        @default(now())
  traiteLe     DateTime?
  relances     Int             @default(0)

  @@index([statut])
}

// ───────────── Messagerie et rendez-vous ─────────────

enum Interlocuteur {
  agence
  notaire
}

model Conversation {
  id               String        @id @default(cuid())
  sujet            String
  bienId           String?
  bien             Bien?         @relation(fields: [bienId], references: [id], onDelete: SetNull)
  dossierId        String?
  dossier          Dossier?      @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  acheteurId       String
  acheteur         Utilisateur   @relation(fields: [acheteurId], references: [id], onDelete: Cascade)
  avec             Interlocuteur
  interlocuteurNom String
  creeLe           DateTime      @default(now())

  messages Message[]
  lectures LectureConversation[]

  @@index([acheteurId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  auteurId       String
  auteur         Utilisateur  @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  texte          String
  fichier        String?
  date           DateTime     @default(now())

  @@index([conversationId, date])
}

model LectureConversation {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  utilisateurId  String
  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  luLe           DateTime     @default(now())

  @@id([conversationId, utilisateurId])
}

model RendezVous {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  notaireId     String
  notaire       Notaire     @relation(fields: [notaireId], references: [id], onDelete: Cascade)
  dossierId     String?
  dossier       Dossier?    @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  date          DateTime
  motif         String
  clientNom     String?

  @@index([notaireId, date])
}

model NotificationLue {
  utilisateurId  String
  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  notificationId String
  lueLe          DateTime    @default(now())

  @@id([utilisateurId, notificationId])
}

// Formulaires de contact et demandes envoyées depuis les pages publiques, sans compte.
model MessageContact {
  id        String   @id @default(cuid())
  type      String
  bienId    String?
  bienTitre String?
  agence    String?
  montant   String?
  nom       String
  contact   String
  message   String
  envoyeur  String?
  date      DateTime @default(now())
}

// ───────────── Modération et avis ─────────────

enum StatutSignalement {
  ouvert
  classe
  retire
}

model Signalement {
  id       String            @id @default(cuid())
  bienId   String
  bien     Bien              @relation(fields: [bienId], references: [id], onDelete: Cascade)
  auteurId String
  auteur   Utilisateur       @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  motif    String
  detail   String?
  date     DateTime          @default(now())
  statut   StatutSignalement @default(ouvert)

  @@unique([bienId, auteurId])
}

enum CibleAvis {
  notaire
  agence
}

model Avis {
  id        String      @id @default(cuid())
  cible     CibleAvis
  // Identifiant public (slug) du notaire ou de l'agence noté.
  slug      String
  dossierId String
  dossier   Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  auteurId  String
  auteur    Utilisateur @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  note      Int
  texte     String
  date      DateTime    @default(now())

  // Un seul avis par dossier et par professionnel.
  @@unique([dossierId, cible, slug])
  @@index([cible, slug])
}

// ───────────── Revenus ─────────────

enum StatutCommande {
  nouvelle
  traitee
}

model CommandeService {
  id        String         @id @default(cuid())
  serviceId String
  montant   BigInt
  nom       String
  telephone String
  email     String?
  bienId    String?
  note      String?
  date      DateTime       @default(now())
  statut    StatutCommande @default(nouvelle)
}

enum StatutFinancement {
  nouvelle
  transmise
}

model DemandeFinancement {
  id        String            @id @default(cuid())
  offreId   String
  nom       String
  telephone String
  montant   BigInt
  duree     Int
  revenu    BigInt?
  date      DateTime          @default(now())
  statut    StatutFinancement @default(nouvelle)
}

model AbonneNewsletter {
  email      String   @id
  inscritLe  DateTime @default(now())
}

// Compteurs des encarts sponsorisés, par campagne.
model StatPublicite {
  campagneId String @id
  vues       Int    @default(0)
  clics      Int    @default(0)
}

// ───────────── Réglages de la plateforme ─────────────

// Une ligne par réglage : « parametres » (taux, délais, interrupteurs) et « permissions » (matrice des rôles).
model Reglage {
  cle       String   @id
  valeur    Json
  modifieLe DateTime @updatedAt
}

model JournalReglages {
  id     String   @id @default(cuid())
  date   DateTime @default(now())
  auteur String
  detail String
}
