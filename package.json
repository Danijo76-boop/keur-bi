{
  "name": "keur-bi",
  "version": "1.21.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/base-locale.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:start": "node scripts/base-locale.mjs",
    "db:stop": "pg_ctl -D .pgdata stop",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "vercel-build": "prisma generate && node scripts/migrer.mjs && next build",
    "securite": "trivy fs --config trivy.yaml .",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:verifier": "prettier --check .",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:surveiller": "vitest",
    "verifier": "npm run types && npm run lint && npm run format:verifier && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "next": "^15.5.29",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8",
    "prettier": "^3.10.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.31"
    },
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.5"
  }
}
