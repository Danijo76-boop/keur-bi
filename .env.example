# Copiez ce fichier en .env et renseignez l'adresse de votre base PostgreSQL.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/BASE"

# Facultatif : mot de passe commun des comptes d'exemple, et identifiants du premier administrateur (npm run db:seed).
MOT_DE_PASSE_DEMO=""
ADMIN_EMAIL=""
ADMIN_MOT_DE_PASSE=""

# Vérification du contenu des photos (nudité, violence, données personnelles…). Sans clé : vérification sautée en local, photos refusées en ligne.
ANTHROPIC_API_KEY=""

# Codes de connexion par WhatsApp (API WhatsApp de Meta). Sans ces variables : code affiché à l'écran en local,
# double vérification désactivée en ligne. OTP_WHATSAPP=off la désactive partout.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_MODELE="code_connexion"
# WHATSAPP_LANGUE="fr"

# SMS de secours quand WhatsApp n'aboutit pas. Orange : numéros sénégalais ; Twilio : les autres (et tous si Orange manque).
ORANGE_CLIENT_ID=""
ORANGE_CLIENT_SECRET=""
# ORANGE_SMS_EXPEDITEUR="tel:+2210000"
# ORANGE_SMS_NOM="KEUR BI"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
