# Copiez ce fichier en .env et renseignez l'adresse de votre base PostgreSQL.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/BASE"

# Facultatif : mot de passe commun des comptes d'exemple, et identifiants du premier administrateur (npm run db:seed).
MOT_DE_PASSE_DEMO=""
ADMIN_EMAIL=""
ADMIN_MOT_DE_PASSE=""

# Vérification du contenu des photos (nudité, violence, données personnelles…). Sans clé : vérification sautée en local, photos refusées en ligne.
ANTHROPIC_API_KEY=""
